# Simulated online payment is the default; it does not transfer real money.
PAYMENT_MODE=demo

# To use eSewa instead, set PAYMENT_MODE=esewa and configure merchant access.
ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# Leave ESEWA_PUBLIC_BASE_URL unset for same-Wi-Fi testing. The server will
# use its LAN address for eSewa's return URL. Set a reachable HTTPS origin
# when hosting the cashier publicly.
# ESEWA_PUBLIC_BASE_URL=https://your-public-https-domain.example

# For live payments, replace the sandbox settings with merchant-issued values:
# ESEWA_ENV=production
# ESEWA_PRODUCT_CODE=your_merchant_product_code
# ESEWA_SECRET_KEY=your_private_merchant_secret
# ESEWA_PUBLIC_BASE_URL=https://your-public-https-domain.example
